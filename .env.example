APP_NAME="Wallgold Price Alerts"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker Compose stack (see README for bare-metal overrides)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=wallgold
DB_USERNAME=wallgold
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# Host port Compose publishes Redis on (loopback only), for tests run on the host
REDIS_HOST_PORT=6379
REDIS_QUEUE_BLOCK_FOR=5
REDIS_QUEUE_RETRY_AFTER=90

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="alerts@wallgold.test"
MAIL_FROM_NAME="${APP_NAME}"
MAILPIT_PORT=8025
MAILPIT_SMTP_PORT=1025

# Image build sources. Defaults point at ArvanCloud's mirrors; outside Iran use
# DOCKER_REGISTRY=docker.io and APK_MIRROR=https://dl-cdn.alpinelinux.org/alpine.
# COMPOSER_MIRROR is optional (for example https://mirror.kargadan.ir/repository/composer-jamko/).
DOCKER_REGISTRY=docker.arvancloud.ir
APK_MIRROR=https://mirror.arvancloud.ir/alpine
COMPOSER_MIRROR=

# Gold price feed: "fake" (seeded random walk, default) or "goldapi" (needs a token)
GOLD_PRICE_PROVIDER=fake
GOLD_PRICE_UNIT="USD/oz"
GOLD_POLL_INTERVAL_MS=1000
GOLD_FAKE_START=2650.00
GOLD_FAKE_MAX_STEP=2.00
GOLD_FAKE_SEED=
GOLD_API_URL=https://www.goldapi.io/api/XAU/USD
GOLD_API_TOKEN=
